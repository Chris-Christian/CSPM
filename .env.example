# Template only. Python does not automatically load this file.
CSPM_TARGET=localstack
CSPM_REGION=us-east-1
CSPM_LOCALSTACK_ENDPOINT_URL=http://localhost:4566

# LocalStack currently requires its own auth token for the Docker image.
# Replace this placeholder in your ignored local .env file; never put AWS
# credentials here.
LOCALSTACK_AUTH_TOKEN=your-localstack-auth-token
